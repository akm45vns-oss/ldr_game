rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getCouple(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId));
    }

    function isCoupleMember(coupleId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/couples/$(coupleId)) &&
        request.auth.uid in getCouple(coupleId).data.members;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Couple Membership Records (Directly supports Spark Free Plan & Blaze Plan)
    match /couples/{coupleId} {
      // Members can read their couple record
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;

      // Create couple: Creator must be the initial sole member
      allow create: if isAuthenticated() &&
        request.resource.data.members == [request.auth.uid] &&
        request.resource.data.coupleId == coupleId;

      // Update couple:
      // Case 1: Existing member updates metadata or invites (without tampering member list)
      // Case 2: Second member joins an open couple (members.size() == 1 -> 2)
      allow update: if isAuthenticated() && (
        (request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members) ||
        (resource.data.members.size() == 1 &&
         !(request.auth.uid in resource.data.members) &&
         request.resource.data.members.size() == 2 &&
         request.auth.uid in request.resource.data.members)
      );

      allow delete: if false;

      // Shared Cloud Save Subcollection
      match /shared_save/{saveDoc} {
        allow read: if isCoupleMember(coupleId);
        allow create, update: if isCoupleMember(coupleId) &&
          request.resource.data.version == 2 &&
          request.resource.data.collectedIds is list &&
          request.resource.data.unlockedMemories is list &&
          request.resource.data.questItems is list &&
          request.resource.data.storyFlags is map &&
          request.resource.data.revision is int &&
          request.resource.data.resetGeneration is int;
        allow delete: if false;
      }
    }

    // Cryptographic Invitations (Protected by SHA-256 Hashing and Atomic Single-Use)
    match /invites/{inviteHash} {
      // Any authenticated user can read an invite to verify code hash and coupleId
      allow read: if isAuthenticated();

      // Only a verified member of that couple can create an invitation for it
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.createdBy &&
        isCoupleMember(request.resource.data.coupleId) &&
        request.resource.data.redeemed == false &&
        request.resource.data.expiresAt > request.time.toMillis();

      // Atomic redemption: Can only transition once from redeemed: false to redeemed: true
      allow update: if isAuthenticated() &&
        resource.data.redeemed == false &&
        request.resource.data.redeemed == true &&
        request.resource.data.redeemedBy == request.auth.uid &&
        resource.data.expiresAt > request.time.toMillis();

      allow delete: if false;
    }
  }
}
