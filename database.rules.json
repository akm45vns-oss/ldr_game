{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$coupleId": {
        ".read": "auth != null && root.child('rooms').child($coupleId).child('members').child(auth.uid).val() === true",
        "members": {
          ".read": "auth != null && root.child('rooms').child($coupleId).child('members').child(auth.uid).val() === true",
          ".write": false
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($coupleId).child('members').child(auth.uid).val() === true",
            ".validate": "newData.hasChildren(['x', 'y', 'facing', 'animState', 'updatedAt'])",
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 10000"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= -500 && newData.val() <= 2000"
            },
            "vx": {
              ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000"
            },
            "vy": {
              ".validate": "newData.isNumber() && newData.val() >= -2000 && newData.val() <= 2000"
            },
            "facing": {
              ".validate": "newData.isString() && (newData.val() === 'left' || newData.val() === 'right')"
            },
            "animState": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "grounded": {
              ".validate": "newData.isBoolean()"
            },
            "zoneId": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "displayName": {
              ".validate": "newData.isString() && newData.val().length <= 50"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 50"
            },
            "sessionId": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "protocolVersion": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($coupleId).child('members').child(auth.uid).val() === true",
            ".validate": "newData.hasChildren(['online'])",
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "inRoom": {
              ".validate": "newData.isBoolean()"
            },
            "zoneId": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "displayName": {
              ".validate": "newData.isString() && newData.val().length <= 50"
            },
            "sessionId": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "appHidden": {
              ".validate": "newData.isBoolean()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "disconnectedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "events": {
          "$eventId": {
            ".write": "auth != null && root.child('rooms').child($coupleId).child('members').child(auth.uid).val() === true",
            ".validate": "newData.hasChildren(['type', 'senderUid', 'timestamp']) && newData.child('senderUid').val() === auth.uid && (newData.child('type').val() === 'collectible_pickup' || newData.child('type').val() === 'heart_burst' || newData.child('type').val() === 'bridge_repaired' || newData.child('type').val() === 'shrine_ignited')",
            "type": {
              ".validate": "newData.isString() && (newData.val() === 'collectible_pickup' || newData.val() === 'heart_burst' || newData.val() === 'bridge_repaired' || newData.val() === 'shrine_ignited')"
            },
            "senderUid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            },
            "payload": {
              ".validate": "newData.hasChildren()",
              "itemId": {
                ".validate": "newData.isString() && newData.val().length <= 32"
              },
              "itemType": {
                ".validate": "newData.isString() && (newData.val() === 'crystal' || newData.val() === 'memory')"
              },
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 10000"
              },
              "y": {
                ".validate": "newData.isNumber() && newData.val() >= -500 && newData.val() <= 2000"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "coopState": {
          ".write": "auth != null && root.child('rooms').child($coupleId).child('members').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren()",
          "pressurePlate": {
            ".validate": "newData.hasChildren(['pressed', 'timestamp']) && ((newData.child('pressed').val() === true && newData.child('pressedBy').val() === auth.uid) || (newData.child('pressed').val() === false && (newData.child('pressedBy').val() === null || !newData.hasChild('pressedBy'))))",
            "pressed": {
              ".validate": "newData.isBoolean()"
            },
            "pressedBy": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val() === auth.uid)"
            },
            "timestamp": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
