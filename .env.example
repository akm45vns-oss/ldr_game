# Pixel Hearts — Firebase Environment Configuration
# Copy this file to .env or configure these variables in Vercel Project Settings

# Firebase Web App Credentials (Found in Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Set to 'true' to connect client to local Firebase Emulator Suite (Auth: 9099, Firestore: 8080, Functions: 5001, Database: 9000)
VITE_USE_FIREBASE_EMULATORS=false
